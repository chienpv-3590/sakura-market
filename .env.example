# Copy thanh .env.local roi dien gia tri tu Supabase Dashboard -> Settings -> API Keys.
# Project LAB-3: Aicoding (ref esgqneojskshvidhivgv).

# URL project, lo ra client la binh thuong.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Khoa cong khai (publishable / anon). Lo ra client la AN TOAN va dung thiet ke:
# cai bao ve du lieu la RLS o Phase 03, khong phai su bi mat cua khoa nay.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-hoac-anon-key>

# Khoa bi mat (secret / service_role). BO QUA RLS.
# Chi dung o Node runtime phia server va script seed. TUYET DOI khong commit,
# khong dat tien to NEXT_PUBLIC_, khong import vao bat ky file "use client" nao.
SUPABASE_SECRET_KEY=<secret-hoac-service-role-key>
